{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "mutate": [
    "src/**/*.ts"
  ],
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "tempDirName": ".stryker-tmp",
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 85
  },
  "commandRunner": {
    "command": "npm test"
  },
  "tsconfigFile": "tsconfig.mutation.json"
}

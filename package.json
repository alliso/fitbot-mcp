{
  "name": "fitbot-mcp",
  "version": "0.1.1",
  "description": "MCP server para reservar clases y consultar horarios en AimHarder",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aimharder",
    "crossfit",
    "claude"
  ],
  "homepage": "https://github.com/alliso/fitbot-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alliso/fitbot-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/alliso/fitbot-mcp/issues"
  },
  "bin": {
    "fitbot-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",

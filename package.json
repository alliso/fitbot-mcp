{
  "name": "fitbot-mcp",
  "version": "0.1.5",
  "description": "MCP server para reservar clases y consultar horarios en AimHarder",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aimharder",
    "crossfit",
    "claude"
  ],
  "homepage": "https://github.com/alliso/fitbot-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alliso/fitbot-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/alliso/fitbot-mcp/issues"
  },
  "bin": {
    "fitbot-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
